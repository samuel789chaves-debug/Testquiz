local function awaitAnswer(targetQuestion)
    if not quizRunning then
        return
    end
    awaitingAnswer = true
    local timeIsOut = false
    local function Timeout()
        if not quizRunning then
            return
        end
        task.wait(settings.questionTimeout)
        UpdateBoothgameTexts("⏰ "..targetQuestion.rightAnswer..")"..targetQuestion.answers[targetQuestion.rightAnswerIndex], true)
        timeIsOut = true
        currentQuestion = nil
        questionAnsweredBy = nil
        awaitingAnswer = false
        SendMessageWhenReady("⏰ | O tempo acabou! A resposta correta era: "..targetQuestion.rightAnswer..")"..targetQuestion.answers[targetQuestion.rightAnswerIndex], true)
    end
    local function SignTime()
        timeLeft = settings.questionTimeout
        while timeLeft > 0 do
            if questionAnsweredBy then
                return
            end
            local roundedTimeLeft = math.round(math.abs(timeLeft))
            if roundedTimeLeft % 2 == 0 then
                if settings.romanNumbers then
                    task.defer(UpdateBoothgameTexts, tostring(intToRoman(roundedTimeLeft)))
                else
                    task.defer(UpdateBoothgameTexts, tostring(roundedTimeLeft))
                end
            end
            timeLeft -= task.wait(1)
        end
    end
    local timeoutCoroutine = coroutine.create(Timeout)
    local signTimeCoroutine = coroutine.create(SignTime)
    coroutine.resume(timeoutCoroutine)
    if boothGame then
        coroutine.resume(signTimeCoroutine)
    end

    if mode == "Quiz" then
        while questionAnsweredBy == nil and (table.find({"normal", "running", "suspended"}, coroutine.status(timeoutCoroutine))) and quizRunning do
            task.wait()
        end
        if timeIsOut or not quizRunning then
            return
        end
        coroutine.close(timeoutCoroutine)
        coroutine.close(signTimeCoroutine)
        pointManager.AddPoints(questionAnsweredBy, targetQuestion.value)
        task.delay(0.5, function()
            UpdateBoothgameTexts("✔️ "..targetQuestion.rightAnswer..")"..targetQuestion.answers[targetQuestion.rightAnswerIndex], true)
        end)
        SendMessageWhenReady("✔️ | "..questionAnsweredBy.DisplayName.." respondeu corretamente. A resposta era: "..targetQuestion.rightAnswer..")"..targetQuestion.answers[targetQuestion.rightAnswerIndex], true, "[Nome do jogador filtrado] respondeu corretamente. A resposta era: "..targetQuestion.rightAnswer..")"..targetQuestion.answers[targetQuestion.rightAnswerIndex])
        questionAnsweredBy = nil
        awaitingAnswer = false
        table.clear(userCooldowns)
    else
        while table.find({"normal", "running", "suspended"}, coroutine.status(timeoutCoroutine)) and quizRunning do
            task.wait(1)
            questionPoints -= questionPoints / settings.questionTimeout
        end
        task.wait(2)
        if not quizRunning then
            return
        end
        if #answeredCorrectly > 0 then
            local tempuserList = {}
            local currentLength = 37
