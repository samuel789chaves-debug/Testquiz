local function EscapePattern(pattern: string)
    local escapePattern = "[%(%)%.%%%+%-%*%?%[%]%^%$]"
    return string.gsub(pattern, escapePattern, "%%%1")
end

local antiFilteringDone: boolean
local importantMessageSent: boolean
local messageBeforeFilter: string
local answeredByAltMessage: string
local mainQuestionSent: boolean
local messageFiltered: boolean
local lastMessageTime: number
function SendMessageWhenReady(message: string, important: boolean?, altMessage: string?)
    if not quizRunning or settings.disableChat then
        return
    end
    if not settings.repeatTagged then
        important = false
    end
    if important then
        importantMessageSent = true
        messageBeforeFilter = message
        answeredByAltMessage = altMessage
        messageFiltered = false
        antiFilteringDone = false
    end
    if tick() - timeSinceLastMessage >= minMessageCooldown then
        Chat(message)
        timeSinceLastMessage = tick()
    else
        task.wait(minMessageCooldown - (tick() - timeSinceLastMessage))
        if not quizRunning then
            return
        end
        Chat(message)
        timeSinceLastMessage = tick()
    end
    if important then
        lastMessageTime = tick()
        while (not antiFilteringDone or mainQuestionSent) and quizRunning and settings.repeatTagged do
            task.wait()
            if tick() - lastMessageTime > 4.5 then
                notify("Falha ao enviar mensagem do quiz", "Limite de taxa de mensagens excedido. Evite enviar mensagens no chat enquanto um quiz estiver em execução. Isso também pode ser causado por alta latência de rede.", nil, 10)
                messageFiltered = true
                break
            end
        end
    end
    importantMessageSent = false
end

