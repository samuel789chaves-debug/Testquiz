settingsTab:CreateInput({
    Name = "Enviar placar do quiz atual a cada X perguntas",
    PlaceholderText = settings.sendLeaderBoardAfterQuestions,
    Callback = function(value)
        if value and tonumber(value) then
            settings.sendLeaderBoardAfterQuestions = tonumber(value)
            if not settings.automaticCurrentQuizLeaderboard then
                notify("Placar do quiz atual desativado", "Esta configuração não tem efeito enquanto o envio automático do placar do quiz atual estiver desativado")
            end
        end
    end
})

settingsTab:CreateDivider()
local disableBothLeaderboardsToggle, disableCurrentLeaderboardToggle, disableServerLeaderboardToggle
local originalSettings: { boolean } = {not settings.automaticCurrentQuizLeaderboard, not settings.automaticServerQuizLeaderboard}
disableBothLeaderboardsToggle = settingsTab:CreateToggle({
    Name = "Desativar envio automático de ambos os placares",
    CurrentValue = not settings.automaticLeaderboards,
    Callback = function(value)
        settings.automaticLeaderboards = not value
        if value then
            originalSettings = {not settings.automaticCurrentQuizLeaderboard, not settings.automaticServerQuizLeaderboard}
            disableCurrentLeaderboardToggle:Set(true)
            disableServerLeaderboardToggle:Set(true)
        else
            disableCurrentLeaderboardToggle:Set(originalSettings[1])
            disableServerLeaderboardToggle:Set(originalSettings[2])
        end
    end
})
disableCurrentLeaderboardToggle = settingsTab:CreateToggle({
    Name = "Desativar envio automático do placar do quiz atual",
    CurrentValue = not settings.automaticCurrentQuizLeaderboard or not settings.automaticLeaderboards,
    Callback = function(value)
        if value == false and settings.automaticLeaderboards == false then
            originalSettings = {false, not settings.automaticServerQuizLeaderboard}
            settings.automaticLeaderboards = true
            disableBothLeaderboardsToggle:Set(false)
        end
        settings.automaticCurrentQuizLeaderboard = not value
    end
})
disableServerLeaderboardToggle = settingsTab:CreateToggle({
    Name = "Desativar envio automático do placar do servidor",
    CurrentValue = not settings.automaticServerQuizLeaderboard or not settings.automaticLeaderboards,
    Callback = function(value)
        if value == false and settings.automaticLeaderboards == false then
            originalSettings = {not settings.automaticCurrentQuizLeaderboard, false}
            settings.automaticLeaderboards = true
            disableBothLeaderboardsToggle:Set(false)
        end
        settings.automaticServerQuizLeaderboard = not value
    end
})

local originalDoNotRepeatState = not settings.repeatTagged
local doNotRepeatTaggedToggle
local originalFullModeState = settings.boothGameFullMode
local fullModeToggle
if boothGame then
    settingsTab:CreateSection("Configurações do jogo de cabine")
    settingsTab:CreateToggle({
        Name = "Ativar status da placa (requer item de placa)",
        CurrentValue = settings.signStatus,
        Callback = function(value)
            settings.signStatus = value
        end
    })
    settingsTab:CreateToggle({
        Name = "Ativar status da cabine (deve possuir uma cabine)",
        CurrentValue = settings.boothStatus,
        Callback = function(value)
            settings.boothStatus = value
            if not value and originalBoothText ~= "" then
                UpdateBoothText(originalBoothText)
            end
        end
    })
    settingsTab:CreateToggle({
        Name = "Não enviar mensagens do quiz no chat",
        CurrentValue = settings.disableChat,
        Callback = function(value)
            settings.disableChat = value
            if value then
                originalDoNotRepeatState = not settings.repeatTagged
                doNotRepeatTaggedToggle:Set(true)
                originalFullModeState = settings.boothGameFullMode
                fullModeToggle:Set(true)
            else
                doNotRepeatTaggedToggle:Set(originalDoNotRepeatState)
                fullModeToggle:Set(originalFullModeState)
            end
        end
    })
    fullModeToggle = settingsTab:CreateToggle({
        Name = "Listar opções de resposta na placa e na cabine",
        CurrentValue = settings.boothGameFullMode,
        Callback = function(value)
            if not value and settings.disableChat then
                notify("Não é possível alterar a configuração", 'Esta configuração não pode ser alterada enquanto a configuração "não enviar mensagens do quiz no chat" estiver ativada')
                fullModeToggle:Set(true)
                return
            end
            settings.boothGameFullMode = value
        end
    })
    settingsTab:CreateToggle({
        Name = "Usar números romanos para o cronômetro da placa para contornar a filtragem",
        CurrentValue = settings.romanNumbers,
        Callback = function(value)
            settings.romanNumbers = value
        end
    })
    settingsTab:CreateToggle({
        Name = "Desativar notificações push enquanto um quiz está em andamento",
        CurrentValue = settings.boothGameSuppressNotifs,
        Callback = function(value)
            if not value then
                SuppressBoothGameNotifications(false)
            end
            settings.boothGameSuppressNotifs = value
        end
    })
end

settingsTab:CreateSection("Configurações diversas")
doNotRepeatTaggedToggle = settingsTab:CreateToggle({
    Name = "Não repetir mensagens marcadas",
    CurrentValue = not settings.repeatTagged,
    Callback = function(value)
        if not value and settings.disableChat then
            notify("Não é possível alterar a configuração", 'Esta configuração não pode ser alterada enquanto a configuração "não enviar mensagens do quiz no chat" estiver ativada')
            doNotRepeatTaggedToggle:Set(true)
            return
        end
        settings.repeatTagged = not value
        messageFiltered = false
    end
})
settingsTab:CreateToggle({
    Name = "Enviar lista detalhada de categorias no chat (pode ser marcada)",
    CurrentValue = settings.sendDetailedCategorylist,
    Callback = function(value)
        settings.sendDetailedCategorylist = value
    end
})

if outdated then
    settingsTab:CreateToggle({
        Name = "Desativar alertas de versão desatualizada",
        CurrentValue = getDataFileValue("disableVersionAlert"),
        Callback = function(value)
            writeToDataFile("disableVersionAlert", value)
        end
    })
end

settingsTab:CreateSection("Desativar script")
settingsTab:CreateButton({
    Name = "Destruir UI e desativar script",
    Callback = function()
        chatConnection:Disconnect()
        quizCooldown = true
        quizRunning = false
        currentQuestion = nil
        questionAnsweredBy = nil
        awaitingAnswer = false
        ContextActionService:UnbindAction("ToggleUI")
        library:Destroy()
        setgenv("QUIZBOT_RUNNING", false)
    end
})

return CustomCategoryManager
